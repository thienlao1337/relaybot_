# скопируйте в .env и заполните
BOT_TOKEN=123456:ABC-your-token-from-BotFather
ADMIN_ID=0
RUN_MODE=polling

# опционально — включает AI-помощника (нужен хотя бы один ключ; Gemini имеет бесплатный тариф)
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# опционально — цена демо-платежа в Telegram Stars
STARS_PRICE=1

# опционально — строка подключения к Postgres (postgres://... или postgresql://...,
# схема нормализуется автоматически). Не задано — используется SQLite по DB_PATH.
DATABASE_URL=

# опционально — фоновый опрос курсов для алертов (true/false), по умолчанию включён.
# На бесплатном тарифе Render это не даёт сервису засыпать — см. README.
PRICE_WATCH_ENABLED=true
