# Copy to .env and fill in
BOT_TOKEN=123456:ABC-your-token-from-BotFather
ADMIN_ID=0
RUN_MODE=polling

# Optional - enables the AI assistant (at least one key needed; Gemini has a free tier)
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional - price of the demo payment in Telegram Stars
STARS_PRICE=1

# Optional - Postgres connection string (postgres://... or postgresql://...,
# the scheme is normalized automatically). If unset, SQLite at DB_PATH is used.
DATABASE_URL=

# Optional - background rate polling for alerts (true/false), on by default.
# On Render's free plan this keeps the service from sleeping - see README.
PRICE_WATCH_ENABLED=true
